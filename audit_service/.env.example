# Neon Postgres connection string (sslmode=require is mandatory for Neon)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/sentinelci?sslmode=require

# API key for authenticating requests to the audit service (MVP-only auth)
SENTINELCI_AUDIT_API_KEY=change-me-to-a-random-secret
